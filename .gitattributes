# Normalise line endings so the repo is identical regardless of who committed
# from which OS. Without this, a Windows checkout rewrites every file and turns
# the next diff into 30,000 changed lines.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.so binary
*.wasm binary

# Generated; keep them out of diffs and language stats.
package-lock.json linguist-generated=true -diff

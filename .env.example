# =============================================================================
# STRATA environment
#
# Every value here is optional. With none of them set the game runs entirely
# on the simulated chain adapter, which is the intended default.
# =============================================================================

# Which chain adapter to use: mock | devnet | mainnet-beta
#
# Anything other than `mock` also requires NEXT_PUBLIC_PROGRAM_ID. If that is
# missing, `resolveChainMode()` logs a warning and falls back to mock rather
# than shipping a build that throws on first render.
NEXT_PUBLIC_CHAIN_MODE=mock

# Deployed program id, from `anchor deploy`.
# NEXT_PUBLIC_PROGRAM_ID=

# SPL mint of the in-game currency. No token exists yet; leave this unset.
# NEXT_PUBLIC_TOKEN_MINT=

# RPC endpoint. The public Solana endpoints are heavily rate limited and will
# not survive real traffic — use a dedicated provider before launch.
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Shown in the site footer as the "Source on GitHub" link.
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/strata
